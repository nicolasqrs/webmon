**/docker-data/
**/.docker-volumes/

# Grafana / Prometheus / Loki data (runtime)
grafana/data/
prometheus/data/
loki/data/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

