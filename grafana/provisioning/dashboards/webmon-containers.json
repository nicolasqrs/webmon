    {
      "id": 7,
      "title": "Conteneurs · État Docker et sonde",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 10
      },
      "description": "Les nouveaux conteneurs sont intégrés automatiquement. Non testé signifie qu’aucune sonde applicative n’a été détectée ; cela ne garantit pas le fonctionnement de l’application.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Conteneur"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 290
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Résultat"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "text": "Non testé",
                        "color": "orange",
                        "index": 0
                      },
                      "0": {
                        "text": "KO",
                        "color": "red",
                        "index": 1
                      },
                      "1": {
                        "text": "OK",
                        "color": "green",
                        "index": 2
                      },
                      "2": {
                        "text": "Démarrage",
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "État Docker"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "running": {
                        "text": "Démarré",
                        "color": "green",
                        "index": 0
                      },
                      "exited": {
                        "text": "Arrêté",
                        "color": "red",
                        "index": 1
                      },
                      "missing": {
                        "text": "Absent",
                        "color": "red",
                        "index": 2
                      },
                      "restarting": {
                        "text": "Redémarrage",
                        "color": "orange",
                        "index": 3
                      },
                      "paused": {
                        "text": "En pause",
                        "color": "orange",
                        "index": 4
                      },
                      "created": {
                        "text": "Créé",
                        "color": "blue",
                        "index": 5
                      },
                      "dead": {
                        "text": "Défaillant",
                        "color": "red",
                        "index": 6
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sonde"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "auto-http": {
                        "text": "HTTP automatique",
                        "color": "green",
                        "index": 0
                      },
                      "docker-healthcheck": {
                        "text": "Healthcheck Docker",
                        "color": "blue",
                        "index": 1
                      },
                      "webmon": {
                        "text": "Heartbeat",
                        "color": "blue",
                        "index": 2
                      },
                      "docker-state": {
                        "text": "État Docker uniquement",
                        "color": "orange",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Récupération"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "observe-only": {
                        "text": "Observation",
                        "color": "blue",
                        "index": 0
                      },
                      "restart": {
                        "text": "Restart autorisé",
                        "color": "orange",
                        "index": 1
                      },
                      "reconstruct": {
                        "text": "Reconstruction autorisée",
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "webmon_container_functional{container=~\"${container:regex}\",job=\"node-exporter\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{name}}",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Conteneur",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "container": 0,
              "docker_state": 1,
              "probe": 2,
              "Value": 3,
              "recovery_mode": 4
            },
            "renameByName": {
              "container": "Conteneur",
              "docker_state": "État Docker",
              "probe": "Sonde",
              "Value": "Résultat",
              "recovery_mode": "Récupération"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "CPU par conteneur",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "description": "100 % représente un cœur CPU occupé. Une valeur peut dépasser 100 % si plusieurs cœurs sont utilisés. Les courbes viennent de cAdvisor et nécessitent plusieurs échantillons après création.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name=~\"${container:regex}\",name!=\"\"}[$__rate_interval])) * 100) and on (name) label_replace(webmon_container_running{container=~\"${container:regex}\",job=\"node-exporter\"} == 1, \"name\", \"$1\", \"container\", \"(.*)\")",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{name}}",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
