{
  "uid": "webmon-containers",
  "title": "WebMon - Conteneurs",
  "description": "Supervision automatique et lisible des conteneurs du même hôte Docker : état, sonde et ressources.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "webmon",
    "docker",
    "supervision"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Conteneur",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(webmon_container_running{job=\"node-exporter\"})",
        "query": {
          "query": "query_result(webmon_container_running{job=\"node-exporter\"})",
          "refId": "container-variable"
        },
        "regex": "/container=\"([^\"]+)\"/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "Tous",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Conteneurs suivis",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none",
          "decimals": 0,
          "noValue": "En attente"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(webmon_container_running{container=~\"${container:regex}\",job=\"node-exporter\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{name}}",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
